# ==============================================================================
# VideoGuru Environment Configuration Template (SPEC-027)
# ==============================================================================
# Copy this file to .env and populate your personal keys and path overrides:
#   cp .env.example .env
#
# All parameters in this file can be overridden by system environment variables
# or loaded automatically by python-dotenv on application startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Required for live multimodal video understanding (CurationAgent) and
# Gemini Live API bidirectional streaming review. Obtain from Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier
# Default: gemini-2.0-flash (optimal trade-off between latency, token cost, and multimodal context)
# Alternative options: gemini-2.0-pro-exp-02-05, gemini-1.5-flash
# GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Directory Paths
# ------------------------------------------------------------------------------
# Input Directory: Local folder containing raw downloaded video footage (.mp4, .mov, etc.)
# Default: input_videos (falls back to legacy 'media' if input_videos does not exist)
# Windows absolute path example: G:\pankaj\projects\workspaces\videoguru\input_videos
# MEDIA_INPUT_DIR=input_videos

# Staging Directory: Intermediate storage for trimmed clips, OTIO timelines, and temporary files
# Default: staging
# STAGING_DIR=staging

# Output Directory: Destination folder for rendered final videos and auto-generated SRT subtitles
# Default: output_video (falls back to legacy 'output' if output_video does not exist)
# Windows absolute path example: G:\pankaj\projects\workspaces\videoguru\output_video
# OUTPUT_DIR=output_video

# ------------------------------------------------------------------------------
# Transcription & Subtitling Configuration
# ------------------------------------------------------------------------------
# OpenAI Whisper Model Size for speech recognition and subtitle burn-in.
# Supported options: tiny, base, small, medium, large, turbo (and .en English-only variants)
# Default: medium (recommended balance: ~5 GB VRAM, low WER, high accuracy)
# WHISPER_MODEL=medium

# ------------------------------------------------------------------------------
# Agent Orchestration & Autonomous Editing Loop Limits
# ------------------------------------------------------------------------------
# Maximum iterations for the internal LoopAgent (Curation -> Reviewer -> Critic)
# Acts as a circuit breaker to prevent infinite refinement cycles.
# Default: 5
# MAX_LOOP_ITERATIONS=5

# ------------------------------------------------------------------------------
# ADK Web UI & FastApi Server Configuration
# ------------------------------------------------------------------------------
# Application name registered in ADK runtime
# APP_NAME=videoguru

# Host interface to bind the ADK Web UI server
# Default: 127.0.0.1 (use 0.0.0.0 for public / containerized access)
# WEB_HOST=127.0.0.1

# HTTP port for the ADK Web UI server
# Default: 8000
# WEB_PORT=8000

# Default user ID for ADK session memory persistence
# DEFAULT_USER_ID=videoguru_user

