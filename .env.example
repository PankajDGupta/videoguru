# VideoGuru Environment Configuration Template
# Copy this file to .env and populate your personal keys:
#   cp .env.example .env

# Google Gemini API Key (Required for live multimodal analysis & LLM agents)
GEMINI_API_KEY=your_gemini_api_key_here

# Directory Paths
# MEDIA_INPUT_DIR=media
# STAGING_DIR=staging
# OUTPUT_DIR=output

# Model Configurations
# GEMINI_MODEL=gemini-2.0-flash
# WHISPER_MODEL=medium
# MAX_LOOP_ITERATIONS=5

# Web UI Configuration
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# DEFAULT_USER_ID=videoguru_user
